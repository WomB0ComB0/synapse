[Unit]
Description=Synapse encrypted PostgreSQL backup to immutable S3 storage
Documentation=https://github.com/WomB0ComB0/synapse
Wants=network-online.target
After=network-online.target
OnFailure=synapse-operation-alert@%n.service
ConditionPathExists=/etc/synapse/backup.env
ConditionPathExists=/etc/synapse/backup.passphrase
ConditionPathExists=/etc/synapse/aws-credentials
ConditionPathExists=/etc/synapse/aws-config

[Service]
Type=oneshot
User=synapse
Group=synapse
WorkingDirectory=/opt/synapse/current
EnvironmentFile=/etc/synapse/backup.env
Environment=PATH=/usr/local/bin:/usr/bin
Environment=AWS_SHARED_CREDENTIALS_FILE=%d/aws-credentials
Environment=AWS_CONFIG_FILE=%d/aws-config
Environment=SYNAPSE_BACKUP_PASSPHRASE_FILE=%d/backup-passphrase
Environment=SYNAPSE_BACKUP_ROOT=/var/lib/synapse/backups
Environment=SYNAPSE_ENCRYPTED_BACKUP_ROOT=/var/lib/synapse/encrypted-backups
Environment=SYNAPSE_BACKUP_EVIDENCE_ROOT=/var/lib/synapse/recovery-evidence
LoadCredential=aws-credentials:/etc/synapse/aws-credentials
LoadCredential=aws-config:/etc/synapse/aws-config
LoadCredential=backup-passphrase:/etc/synapse/backup.passphrase
ExecStart=/opt/synapse/current/scripts/postgres-backup-s3.sh
TimeoutStartSec=30min
UMask=0077
StateDirectory=synapse
StateDirectoryMode=0700

NoNewPrivileges=true
RemoveIPC=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
KeyringMode=private
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/synapse

[Install]
WantedBy=multi-user.target
