[Unit]
Description=Verify freshness of the latest immutable Synapse database backup
Documentation=https://github.com/WomB0ComB0/synapse
OnFailure=synapse-operation-alert@%n.service

[Service]
Type=oneshot
User=synapse
Group=synapse
WorkingDirectory=/opt/synapse/current
Environment=SYNAPSE_BACKUP_EVIDENCE_ROOT=/var/lib/synapse/recovery-evidence
EnvironmentFile=-/etc/synapse/backup-monitor.env
ExecStart=/opt/synapse/current/scripts/postgres-backup-monitor.sh
UMask=0077
StateDirectory=synapse
StateDirectoryMode=0700

NoNewPrivileges=true
RemoveIPC=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
KeyringMode=private
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/synapse
