[Unit]
Description=Synapse organizational memory and tool gateway
Documentation=https://github.com/WomB0ComB0/synapse
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=synapse
Group=synapse
WorkingDirectory=/var/lib/synapse
EnvironmentFile=/etc/synapse/synapse.env
ExecStart=/opt/synapse/current/synapse
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM

# Synapse persists state in PostgreSQL and needs no host filesystem writes.
StateDirectory=synapse
RuntimeDirectory=synapse
UMask=0077
NoNewPrivileges=true
RemoveIPC=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
KeyringMode=private
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
