[Unit]
Description=Verify an immutable Synapse S3 backup with an isolated database restore
Documentation=https://github.com/WomB0ComB0/synapse
Wants=network-online.target
After=network-online.target
OnFailure=synapse-operation-alert@%n.service
ConditionPathExists=/etc/synapse/restore-drill.env
ConditionPathExists=/etc/synapse/backup.passphrase
ConditionPathExists=/etc/synapse/aws-credentials
ConditionPathExists=/etc/synapse/aws-config

[Service]
Type=oneshot
User=synapse
Group=synapse
WorkingDirectory=/opt/synapse/current
EnvironmentFile=/etc/synapse/restore-drill.env
Environment=PATH=/usr/local/bin:/usr/bin
Environment=AWS_SHARED_CREDENTIALS_FILE=%d/aws-credentials
Environment=AWS_CONFIG_FILE=%d/aws-config
Environment=SYNAPSE_BACKUP_PASSPHRASE_FILE=%d/backup-passphrase
Environment=SYNAPSE_BACKUP_EVIDENCE_ROOT=/var/lib/synapse/recovery-evidence
Environment=SYNAPSE_RESTORE_WORK_ROOT=/var/lib/synapse/restore-work
Environment=SYNAPSE_RESTORE_DRILL=YES
LoadCredential=aws-credentials:/etc/synapse/aws-credentials
LoadCredential=aws-config:/etc/synapse/aws-config
LoadCredential=backup-passphrase:/etc/synapse/backup.passphrase
ExecStart=/opt/synapse/current/scripts/postgres-restore-s3-drill.sh
TimeoutStartSec=45min
UMask=0077
StateDirectory=synapse
StateDirectoryMode=0700

NoNewPrivileges=true
RemoveIPC=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
KeyringMode=private
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/synapse
