# synapse environment configuration.
# Copy to `.env` and adjust for your machine. NEVER commit real secrets — `.env` is git-ignored.
# These variables are read by src/config.rs (Config::from_env), which uses std::env only.

# Postgres connection string (must point at a pgvector-enabled Postgres).
# The service must use a non-owner role so Row-Level Security cannot be bypassed.
# This local value matches docker-compose.yml.
DATABASE_URL=postgres://synapse:synapse@localhost:5432/synapse

# Schema migrations require the database-owner/admin connection. Keep that
# credential separate from DATABASE_URL in production; Synapse never reads it.
# MIGRATION_DATABASE_URL=postgres://owner:password@host/database?sslmode=require

# Runtime posture. production fails closed unless verified JWT auth, a real
# embedding provider, model consistency, rate limiting, ingest idempotency, and
# the durable worker are all enabled.
# SYNAPSE_ENV=development

# Address the HTTP server binds to. Local default in config.rs is 127.0.0.1:8080.
# Use 0.0.0.0:8080 only behind a trusted gateway or inside Docker.
BIND_ADDR=127.0.0.1:8080

# Database and HTTP admission controls. Invalid or zero values fail startup.
# DB_MAX_CONNECTIONS=20
# DB_ACQUIRE_TIMEOUT_SECS=10
# MAX_REQUEST_BODY_BYTES=16777216
# REQUEST_TIMEOUT_SECS=180
# MAX_IN_FLIGHT_REQUESTS=256

# Embedding provider. Inferred as gemini when GEMINI_API_KEY is set, openai when
# OPENAI_API_KEY or EMBEDDING_API_KEY is set, otherwise mock. Set explicitly when
# you want a stable operator-controlled mode.
# EMBEDDING_PROVIDER=gemini

# Embedding model identifier. Defaults to gemini-embedding-2 for Gemini,
# text-embedding-3-small for OpenAI-compatible/mock. EMBEDDING_MODEL overrides all.
# EMBEDDING_MODEL=gemini-embedding-2

# Gemini embeddings (preferred). Synapse uses Gemini's native batchEmbedContents
# API by default and requests 1536-dimensional vectors for the existing pgvector schema.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# OpenAI-compatible embeddings remain supported for OpenAI, Azure, vLLM, LiteLLM,
# or Google's /openai compatibility shim. EMBEDDING_API_KEY is a provider-neutral
# fallback when EMBEDDING_PROVIDER is set explicitly.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=provider-key
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# Explicit degraded/local mode. This is deterministic but not semantically meaningful;
# use only for dev/CI or emergency read-path testing, then re-ingest with a real provider.
# EMBEDDING_PROVIDER=mock

# Embedding HTTP tuning.
# EMBEDDING_MAX_BATCH=96
# EMBEDDING_TIMEOUT_SECS=30
# EMBEDDING_MAX_RETRIES=3

# Retrieval correctness/tuning. Enable model consistency when changing providers
# or models, then re-ingest documents so vectors are all from the same embedding space.
# EMBEDDING_MODEL_CONSISTENCY=true
# RETRIEVAL_MMR_LAMBDA=0.5

# Optional OpenTelemetry OTLP HTTP/protobuf base endpoint. Synapse appends /v1/traces and
# /v1/metrics. Port 4318 is the standard OTLP HTTP receiver; leave unset for JSON logs only.
# Put collector authentication in OTEL_EXPORTER_OTLP_HEADERS, never in the endpoint URL.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20replace-me
# OTEL_ENDPOINT=http://127.0.0.1:4318

# --- Access control (all optional; sensible, backward-compatible defaults) ---

# Real caller authentication. Prefer rotating RS256 keys through AUTH_JWKS_URL;
# static RS256 PEM and HS256 are also supported. JWT identity comes from signed
# claims and X-* identity headers are ignored. With all JWT settings unset,
# trusted headers are accepted for local development or a trusted gateway only.
# Production mode requires verified JWT auth, AUTH_JWT_AUDIENCE, and AUTH_JWT_ISSUER.
# AUTH_JWT_SECRET=change-me-to-a-long-random-secret
# AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# AUTH_JWKS_URL=https://your-idp.example/.well-known/jwks.json
# AUTH_JWT_AUDIENCE=synapse-api
# AUTH_JWT_ISSUER=https://your-idp.example/
# AUTH_JWKS_TIMEOUT_SECS=10
# AUTH_JWKS_MIN_REFETCH_SECS=60
# AUTH_REVOCATION_ENABLED=false
#
# For a single-host static-RS256 deployment, initialize a keypair outside the
# repository and atomically configure the runtime env file:
# scripts/local-rs256-init.sh
# scripts/local-rs256-configure-env.sh /etc/synapse/synapse.env

# Resource ABAC: context ownership. When true, a caller may read/write only their
# OWN context (context.get/upsert require caller == subject). Default false — context
# access is governed by role RBAC alone. Must be a boolean (true/false/1/0/yes/no/
# on/off); an unrecognized value fails fast at boot rather than silently disabling.
# ABAC_CONTEXT_OWNERSHIP=false

# Per-tenant request rate limiting (Postgres-backed token bucket). When RATE_LIMIT_ENABLED
# is true, each tenant may sustain RATE_LIMIT_TENANT_RPS requests/second with bursts up to
# RATE_LIMIT_BURST; a tenant that exceeds it is rejected 429 with a Retry-After header.
# Default off. When enabled, RATE_LIMIT_TENANT_RPS must be > 0 and RATE_LIMIT_BURST must be
# >= 1 (validated fail-fast at boot).
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_TENANT_RPS=10
# RATE_LIMIT_BURST=20

# Idempotent document ingest (request-hash dedupe). When true, re-ingesting a doc_id with a
# BYTE-IDENTICAL request (same content AND metadata/owners/ACL) is a no-op replay (skips re-chunking
# + the expensive re-embedding, returns status "replayed"); any changed field — content OR metadata
# OR ACL — re-ingests as usual and applies it. Default off. Must be a boolean.
# INGEST_IDEMPOTENCY_ENABLED=false

# Outbound MCP/HTTP tool connector. This is unrelated to Synapse's authenticated
# inbound POST /mcp endpoint used by coding agents. With an endpoint configured,
# every outbound tool must first be enabled in the tenant-owned tool registry.
# Production requires HTTPS and an exact MCP_ALLOWED_HOSTS match. MCP_AUTH_TOKEN is
# sent only to that validated endpoint; MCP_SCOPES declares the connector credential's
# granted scopes and calls fail closed when a registered tool requires any others.
# MCP_ENDPOINT=https://tools.example.com/mcp
# MCP_AUTH_TOKEN=replace-with-a-dedicated-connector-token
# Alternative for atomic, zero-downtime credential rotation. Set exactly one token source.
# Production requires an absolute path to a regular file with mode 0600 or stricter.
# MCP_AUTH_TOKEN_FILE=/run/credentials/synapse.service/mcp-token
# MCP_SCOPES=issues:read,issues:write
# MCP_ALLOWED_HOSTS=tools.example.com
# MCP_TIMEOUT_SECS=30
# MCP_MAX_RETRIES=2

# Background run reconciler. Leave off unless the SECURITY DEFINER migration
# functions are owned by an admin/BYPASSRLS migration role.
# WORKER_ENABLED=false
# WORKER_POLL_SECS=30
# WORKER_STALE_SECS=300

# Tracing filter, using tracing-subscriber's EnvFilter syntax.
RUST_LOG=synapse=debug,tower_http=debug,info
